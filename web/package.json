{
  "name": "rflib-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "gen": "node node_modules/openapi-typescript/bin/cli.js ../internal/api/openapi.yaml -o src/api/schema.d.ts",
    "dev": "npm run gen && node node_modules/vite/bin/vite.js",
    "build": "npm run gen && node node_modules/typescript/bin/tsc -p . && node scripts/clean-dist.mjs && node node_modules/vite/bin/vite.js build",
    "typecheck": "npm run gen && node node_modules/typescript/bin/tsc -p .",
    "test": "node node_modules/vitest/vitest.mjs run",
    "e2e": "node node_modules/@playwright/test/cli.js test",
    "browsers": "node node_modules/@playwright/test/cli.js install chromium"
  },
  "dependencies": {
    "@mantine/core": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@mantine/modals": "^9.7.2",
    "@mantine/notifications": "^9.7.2",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.2",
    "leaflet": "^1.9.4",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.30",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
